# Database Configuration (Render PostgreSQL or local SQLite)
DATABASE_URL=postgresql://user:password@localhost:5432/kambusdb

# JWT Secret (minimum 32 random characters)
JWT_SECRET=replace-with-a-secure-random-secret-key-at-least-32-chars

# API Documentation Basic Auth Credentials (Render Environment Variables)
DOCS_USER=admin
DOCS_PASS=replace-with-a-strong-docs-password

# Email / SMTP Settings (for student signup OTP verification)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@kambus.app

# Firebase Cloud Messaging Service Account (optional, for push notifications)
FCM_SERVICE_ACCOUNT_FILE=
